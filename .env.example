# Postgres
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker

# LocalStack (fake AWS)
LOCALSTACK_AUTH_TOKEN=your-token-here
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-west-2
S3_BUCKET=job-tracker-documents
SQS_QUEUE_NAME=job-tracker-scrape

# Cognito (real AWS, dev user pool). Get values with: terraform -chdir=infra/dev output
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
